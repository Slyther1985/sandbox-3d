{
  "$schema": "https://opencode.ai/config.json",
  // Balance costo/calidad para cuenta Gemini Pro ($10/mes)
  "model": "google/gemini-3.1-pro-preview",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": "15%"
  },
  "agents": {
    "sandbox-architect": {
      "description": "Planifica arquitectura, DAG y menús sin editar archivos",
      "mode": "subagent",
      "model": "google/gemini-3.1-pro-preview#high",
      "system": "Respeta el DAG ES6, GEMINI.md, lazy-loading y verify_project.mjs. Propón cambios pequeños y verificables."
    },
    "sandbox-builder": {
      "description": "Implementa nuevas salas de juego y mejoras de menú",
      "mode": "subagent",
      "model": "google/gemini-3.1-pro-preview#medium",
      "system": "Usa la skill sandbox-scaling. Ejecuta node generar_mapa.mjs && node verify_project.mjs al terminar."
    },
    "sandbox-explorer": {
      "description": "Explora código y busca patrones con costo mínimo",
      "mode": "subagent",
      "model": "opencode/beam-free#low"
    }
  }
}
